[Unit]
Description=Koonpinai encrypted PostgreSQL backup (operator-only)
Requires=docker.service
After=docker.service
[Service]
Type=oneshot
User=root
UMask=0077
WorkingDirectory=/opt/koonpinai/release
EnvironmentFile=/etc/koonpinai/compose-paths.conf
ExecStart=/usr/bin/docker compose -f operations/selfhost/compose.yaml --profile operations run --rm tools backup --config=/run/operator/config.json --reason=scheduled
# backup requires replicaRoot for scheduled runs and verifies the encrypted copy.
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
[Install]
WantedBy=multi-user.target
