{
  "name": "koonpinai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:auth:e2e": "playwright test --config playwright.auth.config.ts",
    "test:auth:db": "tsx --test tests/auth-database.test.ts",
    "test:auth:production": "node scripts/check-auth-production.mjs",
    "auth:check": "tsx scripts/check-oidc.ts",
    "db:generate": "drizzle-kit generate",
    "db:audit": "tsx scripts/database-readiness.ts",
    "db:backup": "tsx scripts/database-backup.ts",
    "db:verify-recovery": "tsx scripts/verify-database-recovery.ts",
    "db:portable": "tsx scripts/portable-database.ts",
    "test:selfhost": "tsx scripts/rehearse-selfhost.ts",
    "test:selfhost:docker": "node scripts/rehearse-selfhost-docker.mjs",
    "test:staging:compose": "tsx scripts/rehearse-compose.ts --approve-isolated-writes",
    "db:migrate": "tsx scripts/account-db.ts migrate",
    "users:promote-admin": "tsx scripts/account-db.ts promote-admin"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-thai": "^5.2.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.13",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.0.0",
    "@napi-rs/canvas": "^1.0.11",
    "@playwright/test": "^1.56.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/postcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
