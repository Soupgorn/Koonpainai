# Application
AUTH_URL=http://localhost:3000

# KMITL SSO
AUTH_KEYCLOAK_ISSUER=https://sso.kmitl.ac.th/realms/kmitl
AUTH_KEYCLOAK_ID=YOUR_CLIENT_ID
AUTH_KEYCLOAK_SECRET=YOUR_CLIENT_SECRET
AUTH_SECRET=YOUR_EXISTING_AUTH_SECRET

# PostgreSQL Runtime
DATABASE_URL=YOUR_RUNTIME_DATABASE_URL
DATABASE_CA_FILE=YOUR_CA_CERTIFICATE_PATH

# Application Settings
ENABLE_UI_PREVIEW=false
DATABASE_POOL_MAX=2