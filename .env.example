# Copy to .env.local. Never commit real values or prefix secrets NEXT_PUBLIC_.
AUTH_URL=http://localhost:3000
AUTH_KEYCLOAK_ISSUER=https://sso.kmitl.ac.th/realms/kmitl
AUTH_KEYCLOAK_ID=
AUTH_KEYCLOAK_SECRET=
# Generate at least 32 random bytes, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
DATABASE_URL=
# Runtime secret above belongs only in the web process. Operational settings
# below belong in a SEPARATE CLI environment/secret store after role cutover.
# Explicit Direct/Session credentials required for migrations/admin promotion.
DIRECT_DATABASE_URL=
# Preferred explicit migration endpoint from Supabase Connect: Direct or Session,
# never Transaction pooler. No URL query options except sslmode=verify-full.
MIGRATION_DATABASE_URL=
# Trusted server CA bundle downloaded from the provider's authenticated settings.
# Absolute paths recommended. No CA falls back to Node's verified default roots.
DATABASE_CA_FILE=
MIGRATION_DATABASE_CA_FILE=

# Explicit fictional UI only: development AND all real auth/database values
# above must be empty. This flag never bypasses production authorization.
ENABLE_UI_PREVIEW=false

# Timetables are student-managed in PostgreSQL. No external API or PDF keys.
# Runtime pool accepts only 1 or 2 clients per process; default is 2.
DATABASE_POOL_MAX=2
