# Copy application settings to .env.local; never commit real values or use NEXT_PUBLIC_ for secrets.

# Application
# Production requires the application's HTTPS origin, without a path or query.
AUTH_URL=http://localhost:3000

# KMITL SSO
AUTH_KEYCLOAK_ISSUER=https://sso.kmitl.ac.th/realms/kmitl
AUTH_KEYCLOAK_ID=
AUTH_KEYCLOAK_SECRET=
# Generate at least 32 random bytes; keep the existing secret stable unless rotation is approved.
AUTH_SECRET=

# PostgreSQL Runtime
# Use the restricted application role, never migration/admin credentials.
DATABASE_URL=
# Independently trusted server CA bundle; absolute path recommended.
# Empty uses Node's verified default roots. Self-hosted private CAs require this file.
# This project's Supabase endpoint also requires a trusted provider CA; see AUTH.md.
DATABASE_CA_FILE=
# Every database connection verifies both the certificate chain and hostname.
# Only sslmode=verify-full is allowed as a URL query option. Never disable TLS verification.

# Application Settings
# Fictional UI only: development mode with all real auth/database credentials empty.
# This flag never bypasses production authorization. Timetables use PostgreSQL; no PDF/API keys.
ENABLE_UI_PREVIEW=false
# Runtime pool accepts only 1 or 2 clients per process; default is 2.
DATABASE_POOL_MAX=2

# CLI / Admin (SEPARATE operational environment / secret store)
# These examples document CLI contracts; keep populated values out of .env.local
# and never mount migration/admin credentials into the web container.
# Explicit Direct or Session endpoint; never a Transaction pooler.
# Preferred migration/admin URL; DIRECT_DATABASE_URL is the fallback, not DATABASE_URL.
MIGRATION_DATABASE_URL=
DIRECT_DATABASE_URL=
# Independently trusted migration server CA. Empty falls back to DATABASE_CA_FILE,
# then Node's verified default roots; chain and hostname verification always remain enabled.
MIGRATION_DATABASE_CA_FILE=
# CLI changes require explicit operator approval; this example does not authorize migrations.

# Managed self-hosted runtime uses external private secret files and a pinned endpoint.
# See SELF_HOSTED_POSTGRES.md and operations/selfhost/runtime-manifest.EXAMPLE.json.
