# Server-only opt-in to the local/temporary admin UI in production.
# This is not authentication and does not authorize any server writes.
ENABLE_ADMIN_DEMO=false

# Public build-time file size limit, clamped to 1–50 MiB.
NEXT_PUBLIC_PDF_MAX_MB=10
# Preview-only account screens; never authorizes writes or represents real sign-in.
# Disabled in production unless explicitly enabled for design review.
ENABLE_UI_PREVIEW=false
